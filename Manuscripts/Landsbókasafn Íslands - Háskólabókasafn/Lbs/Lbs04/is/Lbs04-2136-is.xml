					<msContents>
						<summary>
							<title type="supplied">Veraldlegt Vessasafn</title>
						</summary>
						<textLang mainLang="is">Íslenska</textLang>
						<titlePage type="ms">
							<docTitle>
								<titlePart type="main">Veraldlegt Vessasafn eða samtíningur af
									lausavísum ýmislegs efnis, og eftir ýmsa höfunda nafnkennda og
									ókunna, með athugasemdum um orsakir vísnanna.</titlePart>
								<titlePart type="sub">Safnað og samantínt, mest eftir minni og
									sögnum annarra, sér til dægrastyttingar og einhverjum máski til
									gamans er slíku sinna vildi, af Sigmundi Mattíassyni Long.</titlePart>
								<titlePart type="sub">Majus 31ta 1903. Annað bindi.</titlePart>
							</docTitle>
						</titlePage>
						<msItem n="1" class="kvad laus">
							<title type="supplied">Lausavísur</title>
							<note><p>Handritið er skrifað meðan Sigmundur dvaldi í Winnipeg, Kanada.</p>
								<p>Vessasafnið er í þremur bindum undir safnmörkunum Lbs 2135-2137
									4to, í fjórða bindi Lbs 2138 4to er registur eftir
								upphöfum.</p></note>
						</msItem>
						<msItem n="2" class="run stafr malfr gudfr bibl">
							<title type="supplied">Letur og rúnir</title>
							<note><p>Aftast á sundurlausum blöðum ásamt nafnaskrá, málfræðiglósum og broti úr biblíusögu.</p></note>
						</msItem>
					</msContents>
