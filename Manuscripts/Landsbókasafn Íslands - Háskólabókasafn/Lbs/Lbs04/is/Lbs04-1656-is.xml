                        <msItem n="1" defective="false" class="ridd">
                            <title type="uniform">Drauma-Jóns saga</title>
                            <rubric>Sagan af Jóni Draum vitra</rubric>
                            <incipit>Hinrik er jall nemdur, hann var í Saxlandi …</incipit>
                            <colophon>Endað að skrifa dag <date when="1884-11-29">29 November 1884</date> af Magnúsi Teitssyni á Eyrarbakka</colophon>
                            <note><p><name type="person" key="JonJon035">Jón í Simbakoti</name> lét skrifa söguna upp eftir gömlum handritum <name type="person" key="GudHja001">Guðmundar Hjartarsonar</name> á Grjóta við Reykjavík veturinn 1884.</p></note>
                        </msItem>
                        <msItem n="2" defective="false" class="ridd">
                            <title type="uniform">Sagan af Goðleifi prúða</title>
                            <rubric>Sagan af Goðleyfi Prúða (1884)</rubric>
                            <incipit>Austarlega í landinu Portúgal sem liggur næst spaniu …</incipit>
                            <colophon>Endað að skrifa dag <date when="1885-01-03">3 Janúar 1885</date> af M. Teitssyni</colophon>
                            <note><p><name type="person" key="JonJon035">Jón í Simbakoti</name> lét skrifa söguna upp eftir gömlum handritum <name type="person" key="GudHja001">Guðmundar Hjartarsonar</name> á Grjóta við Reykjavík.</p></note>
                        </msItem>
                        <msItem n="3" defective="false" class="fas">
                            <title type="uniform">Fagri riddarinn</title>
                            <rubric>Sagan af Fagra Riddaranum</rubric>
                            <incipit>Einn keisari réði fyrir mest allri suður álfu heimsins …</incipit>
                            <colophon>Skrifað dag <date when="1884-01-10">10 Janúar 1884</date> af Magnúsi Teitssyni</colophon>
                            <note><p>Á líklega að vera 10. janúar 1885.</p>   
                                <p><name type="person" key="JonJon035">Jón í Simbakoti</name> lét skrifa söguna upp eftir gömlum handritum <name type="person" key="GudHja001">Guðmundar Hjartarsonar</name> á Grjóta við Reykjavík.</p>
                            </note>
                        </msItem>
                        <msItem n="4" defective="true" class="fas">
                            <title type="uniform">Huldar saga hinnar miklu</title>
                            <rubric>Sagan af Huld Tröllkonu hinni ríku</rubric>
                            <incipit>Hjörvarður hefur konungur heitið, hann var son Hildibrands …</incipit>
                            <colophon>Handritið er hér á enda og hlýtur að vanta talsvert aftan við það og er það skrifað eftir handriti <name type="person" key="GudHja001">Guðm. Hjörtssonar</name>
                            en hann skrifaði eftir handriti <name type="person" key="GesJoh001">Gests Jóhanesonar</name></colophon>
                            <note><p>Við niðurlag vantar 5 kapitula.</p></note>
                        </msItem>
                        <msItem n="5" defective="false" class="skalds tyd">
                            <title type="uniform">Lukkunnar veltihnöttur</title>
                            <rubric>Hér skrifast eitt æfintýri sem kallast Lukkunnar knattleikur þýtt úr dönsku</rubric>
                            <incipit>Í Madrit í Spaníu var einn útlifaður kongur hvers drottning var önduð …</incipit>
                            <colophon>Endað að skrifa <date when="1885-03-03">3 mars 1885</date> af M. Teitssyni. Jón Jónsson bóndi í Simbakoti hefur látið skrifa Bókina upp</colophon>
                            <note><p><name type="person" key="JonJon035">Jón í Simbakoti</name> lét skrifa söguna upp eftir gömlum handritum <name type="person" key="GudHja001">Guðmundar Hjartarsonar</name> á Grjóta við Reykjavík.</p>
                            </note>
                        </msItem>
                        <msItem n="6" defective="false" class="skalds tyd">
                            <title type="uniform">Draumur Andra Jarls</title>
                            <rubric>Hér skrifast Draumur Andra Jarls</rubric>
                            <incipit>Einu sinni er Andri Jarl sat að drykkju …</incipit>
                            <colophon>Skrifað upp eftir hinu ameríkanska blaði Leifi. Eigandi <name type="person" key="JonJon035">J. Jónsson</name></colophon>
                            </msItem>
                        <msItem n="7" defective="false" class="ridd">
                            <title type="uniform">Hektors saga</title>
                            <rubric>Hér skrifast Saga af Hektor og köppum hans</rubric>
                            <incipit>Eftir niðurbrot Trójóborgar þá Grikkir höfðu hana unnið …</incipit>
                            <colophon>Endað að skrifa þann <date when="1884-12-19">19 Desember 1884</date> af C Q R</colophon>
                            <note><p>Allt hingað til í handritinu er með hendi <name type="person" key="MagTei001">Magnúsar Teitssonar</name>.</p></note>
                        </msItem>
                        <msItem n="8" defective="false" class="ridd">
                            <title type="uniform">Vilhjálms saga sjóðs</title>
                            <rubric>Hér skrifast sagan af Vilhjálmi sjóð</rubric>
                            <incipit>Það er upphaf þessarar sögu að Rígarður hefur konungur heitið …</incipit>
                            <colophon>Þorsteinn Halldórsson Háeyri skrifaði Den Bog. Herra Jón Jónsson á ár <date when="1885">1885</date>.</colophon>
                            </msItem>
