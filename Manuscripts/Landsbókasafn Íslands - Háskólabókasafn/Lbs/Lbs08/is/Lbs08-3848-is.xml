						<msItem n="1" defective="false" class="rimur">
							<title type="uniform">Rímur af Sigurði og Smáfríði</title>
							<rubric>Rímur af Sigurði kóngi og Smáfríði ortar af merkis skáldinu Magnúsi Jónssyni á Skógum (Vestra) <date when="1837">1837</date></rubric>
							<author key="MagJon019">Magnús Jónsson í Magnússkógum</author>
							<incipit type="upphaf">Arabía ríki réð …</incipit>
							<colophon>Endurskrifaðar eftir handriti <name type="person" key="VerJon002">Vernharðar sál Jónssonar</name> á Skúmstöðum á Eyrarbakka 1887-1888 af 
								<name type="person" key="EirPal003">E Pállssyni</name>. Eigandi fræðimaðurinn Herra Jón Jónsson Simbakoti. Endað að skrifa <date when="1888-01-16">16 janúar 88</date></colophon>
							<note>11 rímur, vantar mansöngva.</note>
						</msItem>
						<msItem n="2" defective="false" class="kvad">
							<title type="uniform">Nýjamóðsvísur</title>
							<rubric>Eitt kvæði um nýja móðinn kveðið af séra Jóni Oddssyni Hjaltalín</rubric>
							<author key="JonHja001">Jón Oddsson Hjaltalín á Breiðabólstað</author>
							<incipit type="upphaf">Undir kvásirs oppnaðar, örfast kvæða hljóðin …</incipit>
							<colophon>Skrifað <date when="1893-01-03">3 janúar 1893</date>.</colophon>
							<note>28 erindi.</note>
						</msItem>
						<msItem n="3" defective="false" class="rimur">
							<title type="uniform">Rímur af Blávus og Viktor</title>
							<rubric>Hér skrifast Rímur af Victor og Bláusi ortar af Tómasi Gíslasyni 1830</rubric>
							<author key="SigJon022">Sigurður Jónsson á Stóru-Hvalsá</author>
							<incipit type="upphaf">Vilhjálms nefna vísir má velds …</incipit>
							<colophon>Byrjað að skrifa 13 febrúar fyrir bóndann Jón Jónsson á Simbakoti ortar af Tómasi Gíslasyni eftir handriti 
								<name type="person" key="ThoTho057">Þorkels Þorkelssonar</name> á Hamri af <name type="person" key="ThoHal014">Þorsteini Halldórssyni</name>.
								Endað að skrifa 21 Marts.</colophon>
							<note><p>10 rímur vantar mansöngva.</p> 
								<p>Hér ranglega kenndar <name type="person" key="TomGis001">Tómasi Gíslasyni</name> sem þær eru ortar fyrir.</p></note>
						</msItem>
						
				
