					<msContents>
						<summary>
							<title type="supplied">Sögukver og kvæði</title>
						</summary>
						<textLang mainLang="is">Íslenska</textLang>

						<msItem n="1" class="ridd">
							<title type="uniform">Elís saga og Rósamundu</title>
							<rubric>Hér skrifast sagan af Elís Riddara og Rósamundu</rubric>
							<incipit>Þessi saga hefst af einum ríkum Riddara og Hertoga …</incipit>
							<colophon>Endað að skrifa <date when="1888-02-05">5/2 1888</date> af
									<name type="person" key="OlaSig014">Ólafi Sigurðarsyni</name> á
								Naustakoti</colophon>
						</msItem>
						<msItem n="2" class="ridd">
							<title type="uniform">Flóvents saga</title>
							<rubric>Hér skrifast sagan af Flóvent Frakklandskongi</rubric>
							<incipit>Saga þessi er ey af lok leisu þeirri samansett sem hyggnir menn
								gjöra sér til gamans …</incipit>
							<colophon>Endað að skrifa þann <date when="1888-02-11">5/2 1888</date>.
								Fyrr skrifuð eftir handriti <name type="person" key="MagJon008"
									>Magnúsar Jónssonar</name> á Vigur við Ísafjarðardjúp 1680. Enn
								nú endurskrifuð 1888 eftir handriti <name type="person" key="BjaBjo003">Bjarna Björnssonar</name> á Þingholti
								við Reykjavík árið 1881. Skrifað af <name type="person" key="EyjSig001">Eyjólfi Sigurðssyni</name> á
								Kaðlastöðum Árið 1888</colophon>
						</msItem>
						<msItem n="3" class="kvad">
							<title type="uniform">Reykjavíkurbragur</title>
							<author key="GudTor001">Guðmundur Torfason</author>
							<rubric>Reykjavíkurbragur ortur af Guðmundir Torfasyni á
								Kálfhaga</rubric>
							<incipit type="upphaf">Í muggu og reyk um ókennt stræti …</incipit>
							<colophon><name type="person" key="GudJon">Guðmundur Jónsson</name> skrifaði</colophon>
						</msItem>
						<msItem n="4" class="kvad">
							<title type="uniform">Kvæði af Alexander blinda</title>
							<rubric>Kvæði af Alexander blinda</rubric>
							<incipit type="upphaf">Þá skal fram á þrætukór …</incipit>
							<colophon>Skrifað af <name type="person" key="EirPal003">EPalssyni</name> Simbak. Eftir handriti <name type="person" key="ThoTho057">Þorkels sál
								Þorkelssonar</name> á Hamri</colophon>
						</msItem>
						<msItem n="5" class="annal kvad">
							<title type="uniform">Þýskalandsannáll</title>
							<rubric>Þýskalandsannállinn</rubric>
							<incipit type="upphaf">Byrjast mörgum skjemtanskir skilnings greina
								þráður …</incipit>
							<colophon>Endað að skrifa 8/5 1888 af <name type="person" key="GudJon174">Guðmundi Jónssyni</name> frá
								Sölfholti.</colophon>
						</msItem>
