               <head>
                  <title type="supplied">Skjöl Helgafellsklausturs</title>
                  <origPlace>Ísland</origPlace>
                  <origDate notBefore="1606" notAfter="1606" evidence="external">1606</origDate>
                  <note>Í inngangsorðum kemur fram að <name key="GisTho003" type="person">Gísli
                        Þórðarson</name> lögmaður lét skrifa þetta handrit og bera saman við
                     forritið, gamla og mjög lúna og skemmda bók frá <name type="person">Helgafelli</name>.</note>
               </head>
               <msContents>
                  <textLang mainLang="is">Íslenska</textLang>
                  <msItem class="skjol">
                     <locus from="1r" facs="#AM04-0264-0001r" to="12v">1r-12v</locus>
                     <title type="supplied">Skjöl Helgafellsklausturs</title>
                     <note>Um það bil 50 skjöl varðandi jarðeignir Helgafellsklausturs, að stærstum
                        hluta um landamerki.</note>
                  </msItem>
               </msContents>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="chart">
                        <support>Pappír</support>
                        <extent>12 blöð ().</extent>
                        <foliation>
                           <p/>
                        </foliation>
                        <collation>
                           <p/>
                        </collation>
                        <condition>
                           <p>Límt yfir bl. 1r.</p>
                        </condition>
                     </supportDesc>
                     <layoutDesc>
                        <layout columns="1">
                           <p/>
                        </layout>
                     </layoutDesc>
                  </objectDesc>
                  <handDesc>
                     <p/>
                  </handDesc>
                  <additions>
                     <p>
                        <name key="ArnMag001" type="person">Árni Magnússon</name> bætir við
                        saurblaði, en á því eru upplýsingar um bókina sem hdr. var tekið úr (sjá
                        fylgigögn).</p>
                  </additions>
                  <bindingDesc>
                     <binding notBefore="1973" notAfter="1973" contemporary="false">
                        <p>Band frá því í nóvember 1973.  </p>
                     </binding>
                     <binding contemporary="unknown">
                        <p>Spjöld og kjölur klædd bókfelli sem skrifað er á að innanverðu.  </p>
                     </binding>
                  </bindingDesc>
                  <accMat>
                     <p><list>
                           <item n="1"><locus from="accMat01r" facs="#AM04-0264-accMat01r" to="accMat01v">Seðill</locus>
                                 (<dimensions type="slip" unit="mm">
                                 <height>136</height>
                                 <width>142</width>
                              </dimensions>)með hendi <name key="ArnMag001" type="person">Árna
                                 Magnússonar</name>: <quote xml:lang="is" type="AMSlip">Útskorið úr
                                 dómabók Gísla Þórðarsonar etc. í Stapaumboði er ég fékk af Þórði
                                 Péturssyni á Hólmi.</quote></item>
                           <item n="2">Bréf frá Páli Hákonarsyni</item>
                        </list></p>
                  </accMat>
               </physDesc>
               <history>
                  <origin notBefore="1606" notAfter="1606">
                     <p>Handritið er tímasett til 1606 í <bibl>
                           <ref target="KKKat">Katalog I</ref>
                        </bibl>, bls. 522, en það var áður hluti af <title type="supplied">Dómabók
                           Gísla Þórðarsonar</title> (sjá seðil).</p>
                  </origin>
                  <provenance>
                     <p>
                        <name key="ArnMag001" type="person">Árni Magnússon</name> fékk bókina sem
                        handritið er tekið úr hjá <name type="person">Þórði Péturssyni</name> á
                        Hólmi (sjá seðil).</p>
                  </provenance>
                  <acquisition notBefore="1974-02-13" notAfter="1974-02-13">
                     <p>Stofnun Árna Magnússonar á Íslandi tók við handritinu 13. febrúar 1974.</p>
                  </acquisition>
               </history>
               <additional>
                  <adminInfo>
                     <recordHist>
                        <source>
                           <p>Tekið eftir <bibl>
                                 <ref target="KKKat">Katalog I</ref>
                              </bibl>, bls. 522 (nr. 995). <name key="KriKaa001" type="person">Kålund</name> gekk frá handritinu til skráningar í <date when="1886-11">nóvember 1886</date>. <name key="GudIng001" type="person">GI</name> skráði <date when="2001-10-03">3. október
                                 2001</date>. <name key="MarJon001" type="person">Már Jónsson</name>
                              skráði seðla Árna Magnússonar í <date when="2000-02">febrúar
                                 2000</date>.</p>
                        </source>
                     </recordHist>
                     <custodialHist>
                        <custEvent notBefore="1973" notAfter="1973" type="conservation">
                           <p>Viðgert og bundið í nóvember 1973. Eldra band fylgir.</p>
                        </custEvent>
                     </custodialHist>
                  </adminInfo>
                  <surrogates>
                     <p>
                        <list>
                           <item n="1">Svart-hvítar ljósmyndir á Det Arnamagnæanske Institut í
                              Kaupmannahöfn.</item>
                           <item n="2">Svart-hvítar ljósmyndir á Stofnun Árna Magnússonar á Íslandi,
                              sem keypti þær af <name type="person">Arne Mann Nielsen</name> í <date when="1973-10">október 1973</date>.</item>
                        </list>
                     </p>
                  </surrogates>
                  <listBibl>
                     <bibl>. 1857, <ref target="unknown02">Íslenzkt fornbréfasafn I. 834-1264</ref></bibl>
                     <bibl>Eiríkur Þormóðsson 2003, <ref target="EirÞor2003a">Oddaannálar og Oddverjaannáll</ref></bibl>
                     <bibl>Sveinbjörn Rafnsson 1979, <ref target="SveRaf1979b">Skjalabók Helgafellsklausturs = Registrum Helgafellense</ref></bibl>
                  </listBibl>
               </additional>
