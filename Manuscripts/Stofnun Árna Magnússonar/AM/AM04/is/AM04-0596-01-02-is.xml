                  </objectDesc>
                  <bindingDesc>
                     <binding contemporary="false">
                        <p><!-- <dimensions type="binding"> <height></height><width></width><depth></depth></dimensions> --></p>
                     </binding>
                  </bindingDesc>
                  <accMat>
                     <p>Fastur <locus from="accMat01r" facs="#AM04-0596-01-02-accMat01r" to="accMat01v">seðill</locus> (<dimensions type="slip" unit="mm">
                           <height>164</height>
                           <width>110</width>
                        </dimensions>) fremst með hendi <name key="ArnMag001" type="person">Árna
                           Magnússonar</name> með upplýsingum um aðföng: <quote xml:lang="is" type="AMSlip">Úr sögu af Sigurði þögla komið úr Austfjörðum
                        1711.</quote></p>
                  </accMat>
               </physDesc>
               <history>
                  <provenance>
                     <p>
                        <name key="ArnMag001" type="person">Árni Magnússon</name> fékk handritið frá
                        Austfjörðum árið <date when="1711">1711</date> (sbr. seðil)</p>
                  </provenance>
                  <acquisition notBefore="1976-04-27" notAfter="1976-04-27">
                     <p>Stofnun Árna Magnússonar á Íslandi tók við handritinu 27. apríl 1976.</p>
                  </acquisition>
               </history>
               <additional>
                  <adminInfo>
                     <recordHist>
                        <source>
                           <p>Tekið eftir <bibl>
                                 <ref target="KKKat">Katalog I</ref>
                              </bibl>, bls. 763-764 (nr. 1509). <name key="KriKaa001" type="person">Kålund</name> gekk frá handritinu til skráningar í <date notBefore="1880-10" notAfter="1889-10">október 188?</date>. <name key="DriThr001" type="person">DKÞ</name> skráði handritið <date when="2003-08-25">25. ágúst 2003</date>.</p>
                        </source>
                     </recordHist>
                     <custodialHist>
                        <custEvent type="conservation" notBefore="1964" notAfter="1964">
                           <p>Viðgert af Birgitte Dall 1964.</p>
                        </custEvent>
                     </custodialHist>
                  </adminInfo>
                  <surrogates>
                     <p>
                        <list>
                           <item n="1">Svart-hvítar ljósmyndir á Det Arnamagnæanske Institut í
                              Kaupmannahöfn.</item>
                           <item n="2">Svart-hvítar ljósmyndir á Stofnun Árna Magnússonar á Íslandi,
                              sem keypti þær af <name type="person">Arne Mann Nielsen</name> í <date when="1988-04">apríl 1988</date>.</item>
                        </list>
                     </p>
                  </surrogates>


