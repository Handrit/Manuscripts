               <head>
                  <title type="uniform">Sigurðar saga þögla</title>
                  <origPlace>Ísland</origPlace>
                  <origDate notBefore="1350" notAfter="1500" evidence="external">s. XIV 2/2 + s.
                     XV</origDate>
                  <note>Samsett úr brotum af tveimur handritum.</note>
               </head>
               <physDesc>
                  <objectDesc form="codex">
                     <supportDesc material="perg">
                        <support>Skinn</support>
                        <extent>10 blöð ().</extent>
